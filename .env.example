# Database connection URL (SQLite by default, or PostgreSQL)
DATABASE_URL=sqlite:///./certificates.db

# Storage directory for generated PDF certificates
CERTIFICATES_STORAGE_DIR=./storage/certificates

# Maximum number of recipients allowed per batch generation job
MAX_RECIPIENTS_PER_JOB=5000

# Set to true for running background processing synchronously (useful in test suites)
RUN_BACKGROUND_TASKS_SYNCHRONOUSLY=false

# Structured logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Server host and port
HOST=0.0.0.0
PORT=8000
